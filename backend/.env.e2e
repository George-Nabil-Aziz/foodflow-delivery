# ---------------------------------------------------------------------------
# Backend environment for the end-to-end run. Committed on purpose: every value
# here is a development placeholder pointing at a throwaway local database.
# NEVER put a real secret in this file.
#
# The database is deliberately its own (`foodflow_e2e`), so an end-to-end run
# can truncate and re-seed freely without touching development or unit-test
# data.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4100

DATABASE_URL=postgres://foodflow:foodflow@127.0.0.1:5433/foodflow_e2e
TEST_DATABASE_URL=postgres://foodflow:foodflow@127.0.0.1:5433/foodflow_test

JWT_SECRET=e2e-only-placeholder-secret-not-a-real-key-000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=foodflow
JWT_AUDIENCE=foodflow-app

# Cost 10 rather than 12: an end-to-end run registers dozens of users, and
# hashing would otherwise dominate the wall-clock time. Production stays at 12.
BCRYPT_ROUNDS=10

CORS_ORIGINS=http://localhost:5174

TAX_RATE=0.14
PLATFORM_TIMEZONE=Africa/Cairo
ORDER_ACCEPT_TIMEOUT_MINUTES=10
DELIVERY_OFFER_TTL_SECONDS=90
UNASSIGNED_ESCALATION_MINUTES=15

LOG_LEVEL=warn
RUN_JOBS=true
# Dispatch every 2 s instead of every 20 s, so a driver offer appears inside a
# test's timeout rather than on the production cadence.
JOB_INTERVAL_SCALE=0.1

SEED_ADMIN_EMAIL=sayed.hanafy@foodflow.com
SEED_ADMIN_PASSWORD=Admin123!seed
SEED_USER_PASSWORD=Passw0rd!seed

# The suite registers and signs in dozens of users from one address in a couple
# of minutes. Scaling every bucket by 40 keeps all of them in force while the
# run stays underneath; production uses 1.
RATE_LIMIT_MULTIPLIER=40
