# ---------------------------------------------------------------------------
# FoodFlow backend environment. Copy to .env and fill in.
# NEVER commit a real .env. All values here are placeholders.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# PostgreSQL. The test harness refuses any database not ending in _test.
# 5433 is the bundled server started by `npm run db:local`.
# Using Docker (`npm run db:up`) instead? Change both ports to 5432.
DATABASE_URL=postgres://foodflow:foodflow@127.0.0.1:5433/foodflow
TEST_DATABASE_URL=postgres://foodflow:foodflow@127.0.0.1:5433/foodflow_test

# JWT — must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=foodflow
JWT_AUDIENCE=foodflow-app

BCRYPT_ROUNDS=12

# Comma-separated allow-list. "*" is rejected in production.
CORS_ORIGINS=http://localhost:5173

# Business configuration
TAX_RATE=0.14
PLATFORM_TIMEZONE=Africa/Cairo
ORDER_ACCEPT_TIMEOUT_MINUTES=10
DELIVERY_OFFER_TTL_SECONDS=90
UNASSIGNED_ESCALATION_MINUTES=15

# Card payments via Moyasar (spec-11). Leave the keys empty to use the built-in
# fake provider (development and tests only: production then offers cash only).
# Test keys (sk_test_..., pk_test_...) come from the Moyasar dashboard.
# PAYMENT_PROVIDER=moyasar|fake   (default: moyasar when both keys are set)
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
# Shared secret Moyasar echoes as `secret_token` in webhook calls to
# POST /api/payments/webhooks/moyasar. Without it the webhook is disabled.
MOYASAR_WEBHOOK_SECRET=
PAYMENT_CURRENCY=EGP
PAYMENT_TIMEOUT_MINUTES=15

LOG_LEVEL=info
RUN_JOBS=true

# Seeded accounts (development only — never real credentials)
SEED_ADMIN_EMAIL=sayed.hanafy@foodflow.com
SEED_ADMIN_PASSWORD=Admin123!seed
SEED_USER_PASSWORD=Passw0rd!seed
